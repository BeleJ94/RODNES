{
    "name": "belej-consulting/ethan",
    "description": "ETHAN — gestion des livraisons pour sous-traitants miniers du Grand Katanga",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Core/helpers.php", "app/Core/form_helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
        "migrate": "php bin/migrate.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0
    }
}
