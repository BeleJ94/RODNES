# ETHAN — copier en .env (jamais versionné). Les variables d'environnement réelles priment sur ce fichier.
APP_NAME=ETHAN
# local | production
APP_ENV=local
APP_DEBUG=1
APP_URL=http://127.0.0.1:8080
# Préfixe d'URL si l'application n'est pas à la racine du vhost (ex. /Rodnes/public sous XAMPP)
APP_BASE_PATH=
APP_TIMEZONE=Africa/Lubumbashi
APP_LOCALE=fr
APP_CURRENCY=USD
# Clé de 32 octets en base64 : php bin/keygen.php — obligatoire en production (scellement du journal des livraisons)
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rodnes
DB_TEST_NAME=rodnes_test
# En production : utilisateur dédié à privilèges réduits (voir docs/ARCHITECTURE.md §6.3), jamais root
DB_USER=ethan_app
DB_PASS=

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=ETHAN
